ENVIRONMENT=local
DRIVER=~fastapi
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
LLM_CONTEXT_TURNS=50
LLM_ASSISTANT_CONTEXT_TURNS=3
LLM_CONTEXT_TTL_HOURS=12
HISTORY_TODAY_ENABLED=false
MEMORY_AUTO_EXTRACT_ENABLED=true
MEMORY_EXTRACT_BATCH_SIZE=20
MEMORY_EPISODE_TTL_HOURS=72
MEMORY_V2_SHADOW_ENABLED=false
MEMORY_V2_SHADOW_BATCH_SIZE=20
MEMORY_V2_SHADOW_BACKFILL_EXISTING=false
TAVILY_API_KEY=
MIMO_MAX_IMAGES=4
MIMO_MAX_IMAGE_BYTES=10485760
MIMO_TIMEOUT_SECONDS=45
AUDIT_LOG_ENABLED=true
AUDIT_LOG_MAX_BYTES=5242880
AUDIT_LOG_BACKUP_COUNT=3
AUDIT_LOG_TEXT_LIMIT=4000
SUPERUSERS=[]
